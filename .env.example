# Aarogya AI Research Platform — local development

# Paths (relative to repo root unless absolute)
AAROGYA_REPO_ROOT=.
AAROGYA_DATASETS_DIR=datasets
AAROGYA_REGISTRY_DIR=registry
AAROGYA_CONFIGS_DIR=configs
AAROGYA_LAB_DIR=lab

# Inference API
APP_NAME=aarogya-inference-api
APP_ENV=development
API_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
HOST=0.0.0.0
PORT=8000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
