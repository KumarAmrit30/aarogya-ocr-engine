{
  "name": "aarogya-ocr",
  "version": "0.1.0",
  "private": true,
  "description": "Aarogya AI Research Platform — internal research infrastructure for OCR, HTR, layout, medical IE, and VLMs",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
